[project]
name = "capmkt"
version = "0.1.0"
description = "Add your description here"
readme = "README.md"
requires-python = ">=3.11,<3.12"
dependencies = [
    "dbt-core>=1.11,<1.12",
    "dbt-postgres>=1.10,<1.11",
    "numpy>=1.26",
    "pandas>=2.2",
    "plotly>=5.24",
    "psycopg[binary]>=3.2",
    "pydantic-settings>=2.4",
    "pyyaml>=6",
    "requests>=2.32",
    "sqlalchemy>=2.0,<2.1",
    "streamlit>=1.40",
    "tenacity>=9",
    "typer>=0.12",
]

[project.scripts]
capmkt = "capmkt:main"

[build-system]
requires = ["uv_build>=0.13.7,<0.14.0"]
build-backend = "uv_build"

[dependency-groups]
dev = [
    "pre-commit>=4.7.0",
    "pytest>=9.2.0",
    "pytest-cov>=7.1.0",
    "ruff>=0.17.4",
    "sqlfluff>=4.5.0",
    "sqlfluff-templater-dbt>=4.5.0",
]
testpaths = ["tests"]